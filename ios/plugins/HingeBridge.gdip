;
; HingeBridge — Word Wars' own. Tells the game how an iPhone Duo is folded, and
; what glass it is on, by writing a few lines to a file; see
; ios/plugins-src/HingeBridge/HingeBridge.mm.
;
; The binary is not committed. It is built from the source beside it by
; tools/build-hingebridge.sh on the macOS runner, which then turns the preset's
; `plugins/HingeBridge` on — see .github/workflows/ios.yml. With the preset flag
; off, which is how it is committed, this file is inert.
;

[config]
name="HingeBridge"
binary="HingeBridge.xcframework"

initialization="hinge_bridge_init"
deinitialization="hinge_bridge_deinit"

use_swift_runtime=false

[dependencies]
linked=[]
embedded=[]
system=[]

capabilities=[]

files=[]

linker_flags=[]

[plist]
