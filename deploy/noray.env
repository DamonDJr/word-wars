# Only the settings Word Wars changes. Everything else is left at noray's
# defaults — see upstream's .env.example for the full list.

# ---------------------------------------------------------------- room codes
#
# The whole reason this server exists rather than using the public one.
#
# The default is 21 characters of nanoid's mixed-case alphabet, which produces
# codes like eYQ43-0zsuCDyirJScs1M. That is about 126 bits of entropy for
# something two people read to each other over a call, and the mixed case is
# what forces "codes are case-sensitive" into the instructions.
#
# Six characters of a single-case alphabet carries the same entropy as the five
# characters upstream suggests on their 64-character set, so this is no more
# collision-prone than their own recommendation — and codes only exist while the
# host is connected (noray drops them from its registry the moment the TCP
# socket closes), so the space only has to cover rooms open at the same time,
# not every room ever opened.
#
# The alphabet omits I, O, 0 and 1. Those are the pairs people get wrong reading
# a code off a screen, and there are plenty of characters left.
NORAY_OID_LENGTH=6
NORAY_OID_CHARSET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789

# Word codes are the other option: three words from noray's built-in list,
# which would suit this game rather well. Not used, because generateWordId
# joins them with no separator and keeps the capitals — AcornBadgerAvocado —
# and noray matches codes exactly, so a friend typing it lowercase is turned
# away and nothing the client does can rescue that.
# NORAY_ENABLE_WORDS_OID=true
# NORAY_WORDS_OID_LENGTH=3

# ---------------------------------------------------------------------- misc
NORAY_LOGLEVEL=info
